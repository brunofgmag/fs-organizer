#pragma code_page(65001)

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @FSORG_VERSION_MAJOR@,@FSORG_VERSION_MINOR@,@FSORG_VERSION_PATCH@,0
PRODUCTVERSION @FSORG_VERSION_MAJOR@,@FSORG_VERSION_MINOR@,@FSORG_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Bruno Magalhães"
            VALUE "FileDescription", "FS Organizer"
            VALUE "FileVersion", "@FSORG_VERSION@"
            VALUE "InternalName", "fs-organizer"
            VALUE "LegalCopyright", "Distributed under the GNU General Public License version 2."
            VALUE "OriginalFilename", "fs-organizer.exe"
            VALUE "ProductName", "FS Organizer"
            VALUE "ProductVersion", "@FSORG_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
