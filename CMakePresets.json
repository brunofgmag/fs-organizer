{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-qt-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "debug",
      "displayName": "Qt MSVC 2022 x64 - Debug",
      "description": "Debug build of the executable with the Qt runtime deployed beside it.",
      "inherits": "msvc-qt-base"
    },
    {
      "name": "release",
      "displayName": "Qt MSVC 2022 x64 - Release",
      "description": "Release build of the executable with the Qt runtime deployed beside it.",
      "inherits": "msvc-qt-base"
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Qt MSVC 2022 x64 - RelWithDebInfo",
      "description": "Optimised build with symbols and the full Qt runtime.",
      "inherits": "msvc-qt-base"
    },
    {
      "name": "clangd-db",
      "displayName": "Compile DB (Ninja) for clangd",
      "description": "Writes compile_commands.json with cl.exe. Configure it from an x64 Native Tools Command Prompt.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangd-db",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Qt MSVC Debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "release",
      "displayName": "Build Qt MSVC Release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Build Qt MSVC RelWithDebInfo",
      "configurePreset": "relwithdebinfo",
      "configuration": "RelWithDebInfo",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Test Qt MSVC Debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "displayName": "Test Qt MSVC Release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
